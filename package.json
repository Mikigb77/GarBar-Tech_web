{
  "name": "garbar-intec-web",
  "version": "1.0.0",
  "private": true,
  "description": "The company website for GARBAR, IN-TEC, S.L.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "node scripts/create-brand-assets.mjs && next build",
    "start": "node scripts/serve.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run typecheck",
    "test": "npm run test:readme && npm run test:edge && npm run test:site",
    "test:edge": "node --test tests/edge.test.mjs",
    "test:site": "node --test tests/site.test.mjs",
    "smoke": "node scripts/verify-site.mjs https://garbar.tech",
    "preview": "node scripts/serve.mjs",
    "test:readme": "node --test tests/readme.test.mjs"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "sharp": "0.35.5"
  }
}
